         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://apache.org">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.matharsa</groupId>
    <artifactId>load_balancer_round_robin</artifactId>
    <version>1.0-SNAPSHOT</version>

    <parent>
